# PostgreSQL connection. Copy this file to .env and put real values there only;
# .env is gitignored, this file is public.
# Local Postgres (docker compose up -d) — works as-is:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsewatch"
# Supabase instead (copy the direct connection string from your project dashboard):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"

# HMAC secret used to authenticate external agents reporting checks (future use)
AGENT_SECRET="change_me_agent_hmac_secret"

# Telegram alerts (optional — leave empty to disable)
# 1) Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN
# 2) Message your bot once, then check https://api.telegram.org/bot<TOKEN>/getUpdates for your chat id
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Days of check history to keep (older checks are deleted hourly); 0 keeps everything
CHECK_RETENTION_DAYS=30

PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
